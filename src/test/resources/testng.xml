<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="TutorialsNinja Enterprise Regression Suite" parallel="tests" thread-count="2" verbose="1">

    <listeners>
        <listener class-name="com.tutorialsninja.qa.listeners.MyListeners" />
        <listener class-name="com.tutorialsninja.qa.listeners.AnnotationTransformer" />
    </listeners>

    <test name="Functional Tests">
        <classes>
            <class name="com.tutorialsninja.qa.testcases.RegisterTest" />
            <class name="com.tutorialsninja.qa.testcases.LoginTest" />
            <class name="com.tutorialsninja.qa.testcases.SearchTest" />
        </classes>
    </test>

</suite>